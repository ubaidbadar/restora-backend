PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/restaurant_v2?retryWrites=true&w=majority
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# The address people open the app at (not the API's port). Email links (verify, reset password)
# are built from it and reach the API through the app's /api proxy, so they land back in the app.
BETTER_AUTH_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
# Google sign-in (Google Cloud Console, APIs and Services, Credentials). Leave GOOGLE_CLIENT_ID empty to hide the button.
# The Web application client: redirect URI <BETTER_AUTH_URL>/api/v1/auth/callback/google. The secret is needed on the web only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The iOS client (bundle ID app.restora.live), so ID tokens from the iPhone app are accepted.
GOOGLE_IOS_CLIENT_ID=
UPLOAD_DIR=./uploads

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_BUCKET=tonora
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Push alerts for guests' orders and calls. Phones: Expo's push service (an access token is optional, only if
# "enhanced push security" is on in the Expo project). Browsers: web push, keys made once with
# `bunx web-push generate-vapid-keys`; leave them empty to turn browser alerts off.
EXPO_ACCESS_TOKEN=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://restora.live

# SMTP (Brevo relay). Leave SMTP_HOST empty in development to print emails to the console.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The "from" of every email. Empty: "Restora" <SMTP_USER>. Must be an address the SMTP account may send from.
SMTP_FROM=

# restora.live, rendered by this server (site/). The site answers only for these hosts, and only when
# NODE_ENV=production; in development every host gets it. Add restora.live here to preview it there.
NODE_ENV=development
SITE_HOSTS=restora.live,www.restora.live,dev.restora.live
# The site's "Start free" and "Sign in" buttons lead to the app at CLIENT_ORIGIN (above). Read when the site is built
# (bun run build) and when it renders, so set it before building.

# Not read from this file. GitHub Actions deploys (Settings, Secrets and variables, Actions), once for production and
# once for dev (the DEV_ names):
#   Variables: DEPLOY_HOST, DEPLOY_USER, DEPLOY_URL, SITE_URL, HEALTH_PATH, DEV_DEPLOY_HOST, DEV_DEPLOY_USER,
#              DEV_DEPLOY_URL, DEV_SITE_URL, DEV_APP_ROOT
#   Secrets:   DEPLOY_SSH_KEY, DEPLOY_KNOWN_HOSTS, DEV_DEPLOY_SSH_KEY, DEV_DEPLOY_KNOWN_HOSTS
# The server's own .env holds everything above (it is not copied by the deploy).

# Meta WhatsApp Cloud API / restaurant self-service Embedded Signup.
# These settings belong on the BACKEND SERVER only. Never put them in VITE_* variables,
# commit actual values, or paste secrets into support chats.
#
# Old single-number integration variables are NOT replacements:
#   WHATSAPP_ACCESS_TOKEN     = token for ONE old business number, not an app secret or encryption key
#   WHATSAPP_PHONE_NUMBER_ID  = ID of ONE old number; each restaurant connects its own via signup
#   WHATSAPP_TEMPLATE_LANGUAGE = optional old template setting; not used by signup
#   WHATSAPP_GRAPH_VERSION    = not currently read (Graph v26.0 is set in backend code)
# Restaurant tokens/phone IDs are stored per connection in MongoDB after signup.
#
# Meta Developers > App settings > Basic > App ID (not a WhatsApp number ID).
WHATSAPP_META_APP_ID=
# Meta Developers > App settings > Basic > App Secret.
WHATSAPP_META_APP_SECRET=
# Facebook Login for Business > Embedded Signup (v4) > Configuration ID.
WHATSAPP_META_CONFIG_ID=
# Optional: EXACT redirect_uri used in Meta's original OAuth login dialog when
# Meta reports error 100 / subcode 36008 at the code-to-token exchange.
# Inspect the popup's redirect_uri parameter; do NOT invent a Restora callback
# endpoint. This must be an absolute HTTPS URL without a fragment, and should
# match a permitted redirect in Facebook Login for Business settings.
# Leave unset if Meta's Embedded Signup v4 code exchange works without it.
WHATSAPP_META_REDIRECT_URI=
#
# Webhook Callback URL: https://YOUR_API_HOST/api/v1/webhooks/whatsapp
# Generate once with: openssl rand -hex 32
# Copy the exact generated value to Meta's webhook "Verify token" field.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret for webhook X-Hub-Signature-256 verification.
# When using one Meta app, copy the SAME secret as WHATSAPP_META_APP_SECRET above.
WHATSAPP_APP_SECRET=
#
# 64 hexadecimal characters = 32 random bytes used to encrypt each restaurant's
# Meta access token at rest (AES-256-GCM). Generate independently:
#   openssl rand -hex 32
# Never set this to WHATSAPP_ACCESS_TOKEN, App Secret, or Verify Token.
# Keep securely backed up. Changing it makes existing connected tokens unreadable.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
#
# Independent INTERNAL RESTORA platform admin portal, not restaurant roles.
# Email addresses must belong to verified Better Auth accounts.
# Leave empty to deny all platform-owner access until you configure it.
PLATFORM_ADMIN_BOOTSTRAP_EMAILS=
# Exact HTTPS origin(s), comma-separated. Must also be included in CLIENT_ORIGIN above.
# Example: https://admin.restora.live
PLATFORM_ADMIN_ORIGINS=
#
# Meta and platform admin require HTTPS in hosted environments. Set CLIENT_ORIGIN
# to a comma-separated list of approved app + admin origins, e.g.
# CLIENT_ORIGIN=https://app.restora.live,https://admin.restora.live
# Do not delete existing frontend origins when adding the admin host.